{
  "name": "@nutrition/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run --prefix ../shared build",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "pretest": "npm run --prefix ../shared build",
    "test": "vitest run",
    "pretypecheck": "npm run --prefix ../shared build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@nutrition/shared": "*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12"
  }
}
